# 公共配置参考。实际开发请复制 .env.local.example 为 .env.local；
# 测试使用 .env.test，生产机使用平台密钥或未提交的 .env.production。
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

# 会话与访问边界
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30
ALLOW_KEY_REVEAL=false
# false 时模型密钥只从当前账户读取；服务端统一托管密钥时才显式改为 true。
ALLOW_SHARED_MODEL_CREDENTIALS=false

# 本地数据。留空时 local 默认使用 data/；test 默认使用 .runtime/test/。
# AGENT_RUNTIME_DIR=data
# AUTH_DB_PATH=data/auth.db
# AGENT_USER_DATA_ROOT=data/users
# AGENT_LEGACY_USER_ID=1
STORAGE_BACKEND=local

# 手机验证码：console 只允许 local/test；production 应使用 disabled，直到真实适配器完成。
SMS_PROVIDER=console
SMS_DEV_MODE=true
SMS_CODE_SECRET=replace_with_a_long_random_secret


# 对话模型共享配置；只有 ALLOW_SHARED_MODEL_CREDENTIALS=true 时才会使用。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# 可选知识库模型服务
MINERU_API_KEY=
UNSTRUCTURED_API_KEY=
LLAMA_CLOUD_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=
