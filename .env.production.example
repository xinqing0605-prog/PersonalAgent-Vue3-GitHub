APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# 替换为真实域名，禁止 *。
ALLOWED_HOSTS=agent.example.com
ALLOWED_ORIGINS=https://agent.example.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30
ALLOW_KEY_REVEAL=false
# 多租户默认关闭；仅确认所有账户共用服务端模型密钥时开启。
ALLOW_SHARED_MODEL_CREDENTIALS=false

# 当前版本只支持单实例 SQLite/本地文件。生产前必须挂载持久磁盘；
# 多实例上线前再迁移 PostgreSQL、Redis 和对象存储。
AGENT_RUNTIME_DIR=/var/lib/personal-agent
AUTH_DB_PATH=/var/lib/personal-agent/auth.db
AGENT_USER_DATA_ROOT=/var/lib/personal-agent/users
AGENT_LEGACY_USER_ID=0
STORAGE_BACKEND=local

# 未接入真实短信服务前保持 disabled；生产环境禁止 console/dev mode。
SMS_PROVIDER=disabled
SMS_DEV_MODE=false
SMS_CODE_SECRET=


DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
