# Set these in the Docker Studio settings; do not paste private keys into source.
PORT=7860
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=7860
# Replace with the DIRECT application host from the Studio, not the community page.
ALLOWED_HOSTS=replace-with-direct-app-host,localhost,127.0.0.1
ALLOWED_ORIGINS=https://replace-with-direct-app-host
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
ALLOW_KEY_REVEAL=false
ALLOW_SHARED_MODEL_CREDENTIALS=false
AGENT_ROOT_DIR=/app
AGENT_RUNTIME_DIR=/mnt/workspace/personal-agent/data
AUTH_DB_PATH=/mnt/workspace/personal-agent/auth.db
AGENT_USER_DATA_ROOT=/mnt/workspace/personal-agent/users
AGENT_LEGACY_USER_ID=0
STORAGE_BACKEND=local
SMS_PROVIDER=disabled
SMS_DEV_MODE=false
