APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_HOSTS=demo.example.com,localhost,127.0.0.1
ALLOWED_ORIGINS=https://demo.example.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30
ALLOW_KEY_REVEAL=false
ALLOW_SHARED_MODEL_CREDENTIALS=false
AGENT_ROOT_DIR=/app
AGENT_RUNTIME_DIR=/var/lib/personal-agent/data
AUTH_DB_PATH=/var/lib/personal-agent/auth.db
AGENT_USER_DATA_ROOT=/var/lib/personal-agent/users
# Fresh server: every account, including user 1, must live on the persistent volume.
AGENT_LEGACY_USER_ID=0
STORAGE_BACKEND=local
SMS_PROVIDER=disabled
SMS_DEV_MODE=false
SMS_CODE_SECRET=
