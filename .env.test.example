APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=8001
APP_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
ALLOW_KEY_REVEAL=false
ALLOW_SHARED_MODEL_CREDENTIALS=false

# 测试数据与 local 完全隔离。
AGENT_RUNTIME_DIR=.runtime/test
AUTH_DB_PATH=.runtime/test/auth.db
AGENT_USER_DATA_ROOT=.runtime/test/users
AGENT_LEGACY_USER_ID=0
STORAGE_BACKEND=local

SMS_PROVIDER=console
SMS_DEV_MODE=true
SMS_CODE_SECRET=test_only_sms_secret_not_for_production


# 自动化测试默认不调用付费外部服务。
DEEPSEEK_API_KEY=
