APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
ALLOW_KEY_REVEAL=false
ALLOW_SHARED_MODEL_CREDENTIALS=false

# 保留当前已有本地账户和知识库；不要指向 .runtime/test。
AGENT_RUNTIME_DIR=data
AUTH_DB_PATH=data/auth.db
AGENT_USER_DATA_ROOT=data/users
AGENT_LEGACY_USER_ID=1
STORAGE_BACKEND=local

SMS_PROVIDER=console
SMS_DEV_MODE=true
SMS_CODE_SECRET=local_only_change_me_to_a_random_value


DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
